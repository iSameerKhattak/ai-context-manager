# ── App ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
DEBUG=true

# ── Auth (Clerk) ────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=https://clerk.contextclaw.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_AFTER_SIGN_IN_URL=/projects
CLERK_AFTER_SIGN_UP_URL=/projects

# ── Database ────────────────────────────────────────────────────────
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/contextclaw
POSTGRES_URL_SYNC=postgresql://postgres:postgres@localhost:5432/contextclaw

# ── Cache ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Vector DB ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Queue ────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
KAFKA_BROKERS=localhost:9092

# ── LLM Providers ────────────────────────────────────────────────────
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MINIMAX_API_KEY=
LLM_ROUTER_POLICY=cost-balanced

# ── Integrations ─────────────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# ── Storage ──────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_RAW=contextclaw-raw
S3_BUCKET_EXPORTS=contextclaw-exports

# ── Observability ────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=contextclaw

# ── Services ─────────────────────────────────────────────────────────
API_GATEWAY_URL=http://localhost:8000
CHAT_SERVICE_URL=http://localhost:8001
SEARCH_SERVICE_URL=http://localhost:8002
INGEST_SERVICE_URL=http://localhost:8003
WEBHOOK_SERVICE_URL=http://localhost:8004

# ── Billing ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
